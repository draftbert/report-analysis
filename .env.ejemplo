# Credenciales del agente KAIA (OAuth2 client-credentials, Azure AD v1)
KAIA_TENANT_ID=
KAIA_CLIENT_ID=
KAIA_CLIENT_SECRET=
KAIA_RESOURCE=
KAIA_AGENT_BASE_URL=https://iop-kaia-auditoriainterna.cloud.inditex.com/
KAIA_AGENT_INVOKE_PATH=/api/v2/agent/invoke
KAIA_AGENT_MODEL_NAME=gpt-5-mini
KAIA_AGENT_TEMPERATURE=0          # ignorada para modelos reasoning (gpt-5*)
LLM_REASONING_EFFORT=medium       # minimal | low | medium | high

# Alternativas: LLM_PROVEEDOR=anthropic + ANTHROPIC_API_KEY=...  |  LLM_PROVEEDOR=dry-run
