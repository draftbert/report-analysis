# Entorno y credenciales
.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
.expediente_activo

# Evidencia de trabajo por expediente: no se versiona (ver README § Trazabilidad y retención)
expedientes/*/trazas/
expedientes/*/historial/
expedientes/*/salidas/
expedientes/*/*_archivo_*.zip

# Salidas generadas (entregables) y trazas de calibración
salidas/
**/calibracion_estilo_trazas/
/expedientes/
# audio de reuniones y muestras de voz: material temporal del expediente, jamás en git
expedientes/*/entrada/audio/
# informes reales de referencia (nombres de personas): no se versionan
docs/referencia/informes_aprobados/

# Front
frontend/node_modules/
frontend/dist/

# Plantilla PPT original (con comentarios/autores): solo se versiona la saneada en config/
/*.pptx

# Credenciales del despliegue Docker (ver run.sh)
.env.secrets
