# Variables no secretas del despliegue (versionado). Las credenciales van en .env.secrets.
VERSION=latest
TZ=Europe/Madrid          # fechas de trazas, historial y nombres de fichero en hora local
FRONT_PORT=8080           # producción: puerto del front (nginx, que hace proxy de /api al backend)
API_PORT=8000             # desarrollo (--dev): puerto de la API en el host

# KAIA (endpoint y modelo; las credenciales en .env.secrets)
KAIA_AGENT_BASE_URL=https://iop-kaia-auditoriainterna.cloud.inditex.com/
KAIA_AGENT_INVOKE_PATH=/api/v2/agent/invoke
KAIA_AGENT_MODEL_NAME=gpt-5-mini
KAIA_AGENT_TEMPERATURE=0
LLM_REASONING_EFFORT=medium
# KAIA_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize   # transcripción de audio de reuniones (por defecto, con diarización)
# KAIA_TRANSCRIBE_MAX_S=300   # segundos por parte (el gateway de KAIA corta en ~240 s; 5 min ≈ 90 s de proceso)
# Alternativas: LLM_PROVEEDOR=anthropic (+ ANTHROPIC_API_KEY en .env.secrets) | LLM_PROVEEDOR=dry-run
